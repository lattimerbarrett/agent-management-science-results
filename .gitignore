# For every section. A section can add its own .gitignore inside its folder.

# environments, at the top of a section folder only (so nothing inside a section's logs is hidden by these)
/*/.venv/
/*/venv/
/*/node_modules/

# keys never go in files here
/.env
/.env.*
/*/.env
/*/.env.*
!/*/.env.example

# caches and clutter, anywhere
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
